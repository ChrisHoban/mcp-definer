{
  "name": "mcp-definer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "bootstrap": "pnpm install && docker compose -f docker/docker-compose.yml up -d && node packages/db/scripts/migrate.mjs",
    "db:migrate": "pnpm --filter @mcp-definer/db run build && node packages/db/scripts/migrate.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint packages apps scripts vitest.config.ts eslint.config.js && prettier --check \"packages/**/*.{ts,json}\" \"apps/**/*.{ts,json}\" \"*.{json,yaml,yml,js,ts}\" \"tsconfig.build.json\" \"docker/docker-compose.yml\" \"scripts/**/*.mjs\" \".github/**/*.yml\"",
    "lint:fix": "eslint packages apps scripts vitest.config.ts eslint.config.js --fix && prettier --write \"packages/**/*.{ts,json}\" \"apps/**/*.{ts,json}\" \"*.{json,yaml,yml,js,ts}\" \"tsconfig.build.json\" \"docker/docker-compose.yml\" \"scripts/**/*.mjs\" \".github/**/*.yml\"",
    "build": "tsc -b tsconfig.build.json",
    "contract-test": "node scripts/contract-test.mjs",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "test:web": "pnpm --filter @mcp-definer/web test",
    "test:web:coverage": "pnpm --filter @mcp-definer/web test:coverage",
    "test:web:build": "pnpm --filter @mcp-definer/web build",
    "dev:api": "pnpm --filter @mcp-definer/api run dev",
    "dev:web": "pnpm --filter @mcp-definer/web run dev",
    "screenshots": "powershell -ExecutionPolicy Bypass -File scripts/capture-screenshots.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^16.5.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.5",
    "gifenc": "^1.0.3",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.3",
    "turbo": "^2.10.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
